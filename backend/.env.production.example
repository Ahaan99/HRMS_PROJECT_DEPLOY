# ===== HRMS BACKEND — HOSTINGER PRODUCTION =====
# Copy these keys into Hostinger's Environment Variables panel
# for ardhnarishwar-hrms-backend.recruweb.com
# NEVER commit the real values.

# --- Server ---
NODE_ENV=production
PORT=5000

# --- Company Database (fill with company DB credentials in Hostinger) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- CORS: every deployed portal origin, comma-separated, no spaces ---
CORS_ORIGINS=https://ardhnarishwar-admin-hrms.recruweb.com,https://ardhnarishwar-hr-hrms.recruweb.com,https://ardhnarishwar-sales-hrms.recruweb.com,https://ardhnarishwar-client-hrms.recruweb.com,https://ardhnarishwar-employee-hrms.recruweb.com

# --- Email (SMTP) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_USER_2=
EMAIL_PASS_2=
EMAIL_USER_3=
EMAIL_PASS_3=
EMAIL_USER_4=
EMAIL_PASS_4=
EMAIL_USER_5=
EMAIL_PASS_5=
EMAIL_USER_6=
EMAIL_PASS_6=


# --- Smart Attendance ---
SMART_ATTENDANCE_KEY=

# --- AI (only if the server can reach an Ollama instance) ---
OLLAMA_URL=
OLLAMA_MODEL=

# --- API Gateway: internal Python service targets (single-backend mode) ---
EVS_SERVICE_URL=http://127.0.0.1:8000
HR_ROBO_SERVICE_URL=http://127.0.0.1:8001
SMART_ATTENDANCE_SERVICE_URL=http://127.0.0.1:5050
