# ---------------------------------------------------------------
# HRMS backend - copy this file to .env and fill in the values.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
# Tables are created automatically on first start (npm run dev).
# ---------------------------------------------------------------

PORT=5000

# MySQL 8 (create an empty database first: CREATE DATABASE hrms_db;)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrms_db

# Auth - use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
SALES_JWT_SECRET=change_me_to_a_different_long_random_string
JWT_EXPIRES_IN=7d

# Accounts seeded on first start (login at the admin portal).
# In NODE_ENV=production the server refuses to boot while any of these is a default.
SUPER_ADMIN_EMAIL=admin@hrms.com
SUPER_ADMIN_PASSWORD=admin123
MANAGER_PASSWORD=manager123
TL_PASSWORD=tl123

# Sales module
SALES_DEPT_ID=2

# Outgoing email (Gmail app password or any SMTP). Leave blank to disable emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Employee Verification System (EVS) single sign-on
EVS_SSO_KEY=change_me_random_string
EVS_FRONTEND_URL=http://localhost:5180
EVS_APP_URL=http://localhost:5180

# Smart Attendance -> HRMS sync key (any random string, must match nothing else)
SMART_ATTENDANCE_KEY=change_me_random_string

# AI features (HR chatbot / summaries). Optional - features degrade gracefully without it.
GROQ_API_KEY=

# Optional local LLM for HR Robo (leave defaults if not using Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Production only: comma-separated portal origins allowed by CORS / socket.io
# CORS_ORIGINS=https://admin.example.com,https://hr.example.com
